/dts-v1/;

#include "gs101-pixel-common.dtsi"

/ {
	model = "Raven";
	compatible = "google,gs101-raven", "google,gs101";

	/*
	 * ABL picks the base DTB by soc_id (product id 0x09845000 | major
	 * revision); the factory vendor_boot carries one per revision. B0 = 1.
	 */
	soc_id = <0x09845001 0x0>;

	chosen {
		/*
		 * ABL appends its own arguments (console=null among them), so a
		 * panic is silent: panic=10 reboots instead of hanging. init hands
		 * over to the Arch root on userdata when it finds one.
		 */
		bootargs = "console=tty0 panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init";
	};

	/* Target of the debug-policy overlay ABL applies from the dpm partition. */
	dpm: dpm { };

	/* Label stubs so that overlay applies (it only sets their status). */
	dpm-stubs {
		log_arrdumppanic: log-arrdumppanic { status = "disabled"; };
		log_preslcdump: log-preslcdump { status = "disabled"; };
		log_slcdump: log-slcdump { status = "disabled"; };
	};
};

&acpm_ipc {
	pmic-2 {
		regulators {
			ldo4s {
				regulator-name = "vdd2_uwb";
				regulator-min-microvolt = <2500000>;
				regulator-max-microvolt = <3300000>;
			};

			ldo14s {
				regulator-name = "vdd3_uwb";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1950000>;
			};
		};
	};
};

&cont_splash_mem {
	reg = <0x0 0xfac00000 (1440 * 3120 * 4)>;

	status = "okay";
};

&framebuffer0 {
	width = <1440>;
	height = <3120>;
	stride = <(1440 * 4)>;
	format = "a8r8g8b8";

	status = "okay";
};

/* ABL leaves both cluster watchdogs running; take over the second one too. */
&watchdog_cl1 {
	timeout-sec = <30>;

	status = "okay";
};

/*
 * First light: no Type-C driver runs in the initramfs, so don't make the
 * controller wait for one. Plain USB 2 device mode on the USB 2 PHY, as on
 * cheetah, until the MAX77759 TCPC and the USB-C role switch are brought up.
 */
&usbdrd31_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&usbdrd31_phy 0>;
	phy-names = "usb2-phy";
	/delete-property/ role-switch-default-mode;
	/*
	 * Keep usb-role-switch: in peripheral mode it registers nothing, but
	 * without it dwc3 looks for an extcon through the PHY's port and waits
	 * forever for the TCPC to provide one ("failed to get extcon").
	 */
};

/*
 * Without a TCPC driver nothing reports a cable orientation, and with
 * orientation-switch set the PHY never forces VBUS/B-valid, so dwc3 stays
 * "Disconnected". Without it the PHY forces both at init (exynos850-style
 * UTMI init), as it would on a board with no Type-C port controller.
 */
&usbdrd31_phy {
	/delete-property/ orientation-switch;
};

/ {
	/* the amplifiers' VP comes straight from the battery (V_SYS) */
	amp_vp: regulator-amp-vp {
		compatible = "regulator-fixed";
		regulator-name = "amp-vp";
		regulator-min-microvolt = <4200000>;
		regulator-max-microvolt = <4200000>;
		regulator-always-on;
		regulator-boot-on;
	};
};

/*
 * The speaker amplifiers: two CS35L41 on SPI 13 (USI13), as in stock's raven
 * device tree. Chip select 0 is the top speaker (earpiece), 1 the bottom
 * loudspeaker. Their audio comes from the AoC's TDM 0 port; the nodes stay
 * disabled until a sound card describes that link.
 */
&usi13 {
	samsung,mode = <USI_MODE_SPI>;
};

&spi_13 {
	pinctrl-0 = <&spi13_bus &amp_miso &amp_top_cs &amp_bottom_cs>;
	cs-gpios = <&gpp25 3 GPIO_ACTIVE_LOW>, <&gpp1 0 GPIO_ACTIVE_LOW>;
	num-cs = <2>;

	amp_top: amplifier@0 {
		compatible = "cirrus,cs35l41";
		reg = <0>;
		#sound-dai-cells = <1>;
		spi-max-frequency = <25000000>;
		interrupts-extended = <&gpa6 3 IRQ_TYPE_LEVEL_HIGH>;
		reset-gpios = <&gpp16 3 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&amp_top_irq &amp_top_rst>;
		pinctrl-names = "default";
		VA-supply = <&s2mpg11_bucka>;
		VP-supply = <&amp_vp>;
		sound-name-prefix = "Top";
		cirrus,subsystem-id = "raven";
		cirrus,boost-type = <0>;
		cirrus,boost-peak-milliamp = <3500>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <30>;
		cirrus,asp-sdout-hiz = <3>;
		/* the stock protection firmware does not survive hibernation */
		cirrus,dsp-no-hibernate;
		/* GPIO2 = push-pull interrupt, active high */
		cirrus,gpio2-src-select = <5>;
		cirrus,gpio2-output-enable;
		status = "disabled";
	};

	amp_bottom: amplifier@1 {
		compatible = "cirrus,cs35l41";
		reg = <1>;
		#sound-dai-cells = <1>;
		spi-max-frequency = <25000000>;
		interrupts-extended = <&gpa9 6 IRQ_TYPE_LEVEL_HIGH>;
		reset-gpios = <&gpp23 7 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&amp_bottom_irq &amp_bottom_rst>;
		pinctrl-names = "default";
		VA-supply = <&s2mpg11_bucka>;
		VP-supply = <&amp_vp>;
		sound-name-prefix = "Bottom";
		cirrus,subsystem-id = "raven";
		cirrus,boost-type = <0>;
		cirrus,boost-peak-milliamp = <3500>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <30>;
		cirrus,asp-sdout-hiz = <3>;
		cirrus,dsp-no-hibernate;
		cirrus,gpio2-src-select = <5>;
		cirrus,gpio2-output-enable;
		status = "disabled";
	};
};

&pinctrl_far_alive {
	amp_top_irq: amp-top-irq-pins {
		samsung,pins = "gpa6-3";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_gpio_alive {
	amp_bottom_irq: amp-bottom-irq-pins {
		samsung,pins = "gpa9-6";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_peric0 {
	amp_bottom_cs: amp-bottom-cs-pins {
		samsung,pins = "gpp1-0";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	amp_top_rst: amp-top-rst-pins {
		samsung,pins = "gpp16-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};

&pinctrl_peric1 {
	amp_top_cs: amp-top-cs-pins {
		samsung,pins = "gpp25-3";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};

	/* stock pulls MISO down while no chip drives it */
	amp_miso: amp-miso-pins {
		samsung,pins = "gpp25-2";
		samsung,pin-function = <GS101_PIN_FUNC_2>;
		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
	};

	amp_bottom_rst: amp-bottom-rst-pins {
		samsung,pins = "gpp23-7";
		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
	};
};
